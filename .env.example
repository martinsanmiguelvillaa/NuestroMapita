# =============================================
# Variables de entorno para Docker Compose
# Copiar este archivo como .env y completar
# =============================================

# --- Base de datos ---
MYSQL_ROOT_PASSWORD=root_password_cambiar
DB_NAME=nuestro_mapita
DB_USER=mapita
DB_PASSWORD=mapita_password_cambiar

# --- Autenticación de la app ---
# Esta es la contraseña que van a escribir al entrar a la app
APP_PASSWORD=nuestra_clave_secreta

# Clave para firmar los JWT - generar con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_por_clave_muy_larga_y_aleatoria

# --- Cloudinary ---
# Crear cuenta gratis en https://cloudinary.com
# Copiar estos valores del Dashboard de Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- CORS ---
# Orígenes permitidos separados por coma
# Para Docker local: http://localhost:80,http://localhost
# Para producción: agregar el dominio de Vercel
ALLOWED_ORIGINS=http://localhost:80,http://localhost
