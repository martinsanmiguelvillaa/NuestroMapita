# --- Base de datos ---
DB_HOST=db
DB_PORT=3306
DB_USER=mapita
DB_PASSWORD=mapita_password
DB_NAME=nuestro_mapita

# --- Autenticación ---
# Cambiá esto por una contraseña segura
APP_PASSWORD=nuestra_clave_secreta
# Generá una clave larga y aleatoria: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_muy_larga_y_aleatoria

# --- TMDb (búsqueda automática de películas/series) ---
# Opcional. Sin esto la búsqueda automática no funciona, pero podés cargar datos manualmente.
# Clave gratuita en: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Cloudinary ---
# Registrarse en https://cloudinary.com y copiar los datos del dashboard
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- Outfits (API externa clima-en-outfits) ---
# URL base de la API de outfits
OUTFITS_API_URL=https://tu-api-outfits.up.railway.app
# Credenciales de Van
OUTFITS_VAN_MAIL=usuario1@email.com
OUTFITS_VAN_PASSWORD=
# Credenciales de Martín
OUTFITS_MARTIN_MAIL=usuario2@email.com
OUTFITS_MARTIN_PASSWORD=

# --- CORS ---
# Para desarrollo local: http://localhost:5173
# Para producción: el dominio de Vercel, ej: https://nuestro-mapita.vercel.app
ALLOWED_ORIGINS=https://tu-dominio.vercel.app
